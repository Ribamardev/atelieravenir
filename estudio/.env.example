# Supabase (mesmo projeto do Atelier; tabelas e bucket próprios com prefixo sm_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Higgsfield API (console.higgsfield.ai) — cole a chave inteira como veio do botão "Copy API key"
HIGGSFIELD_API_KEY=

# Diretor de arte (escreve os prompts). Use UMA das duas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
